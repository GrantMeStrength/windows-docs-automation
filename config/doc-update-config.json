{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documentation Update Tool Configuration",
  "description": "Configuration settings for the Windows Documentation Update Tool",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "notification": {
      "type": "object",
      "description": "Notification settings for completed updates",
      "properties": {
        "email_recipient": {
          "type": "string",
          "format": "email",
          "default": "jkendirs@microsoft.com",
          "description": "Email address to notify when PRs are created"
        },
        "github_mention": {
          "type": "string",
          "default": "@jkendirs",
          "description": "GitHub username to mention in PR comments"
        },
        "notification_method": {
          "type": "string",
          "enum": ["email", "github_comment", "both"],
          "default": "github_comment",
          "description": "How to notify the docs team"
        }
      }
    },
    "git": {
      "type": "object",
      "description": "Git and GitHub settings",
      "properties": {
        "branch_prefix": {
          "type": "string",
          "default": "doc-update",
          "description": "Prefix for branch names"
        },
        "branch_format": {
          "type": "string",
          "default": "{prefix}/{date}-{slug}",
          "description": "Branch name format. Variables: {prefix}, {date}, {slug}"
        },
        "commit_message_template": {
          "type": "string",
          "default": "[Doc Update] {description}\n\nUpdated based on request: {original_prompt}\n\nChanges:\n{change_summary}\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>",
          "description": "Template for commit messages"
        },
        "prefer_private_repos": {
          "type": "boolean",
          "default": true,
          "description": "Prefer repositories ending in -pr (private repos)"
        },
        "fallback_to_public": {
          "type": "boolean",
          "default": true,
          "description": "Automatically fallback to public repo if private repo access denied"
        },
        "default_base_branch": {
          "type": "string",
          "default": "main",
          "description": "Default base branch for PRs"
        }
      }
    },
    "pull_request": {
      "type": "object",
      "description": "Pull request configuration",
      "properties": {
        "title_prefix": {
          "type": "string",
          "default": "[Minor Edit]",
          "description": "Prefix for PR titles"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["documentation", "doc-update-tool", "quick-edit"],
          "description": "Labels to add to PRs"
        },
        "description_template": {
          "type": "string",
          "description": "Template for PR descriptions. See pr_description_template property below."
        },
        "auto_assign_reviewers": {
          "type": "boolean",
          "default": false,
          "description": "Automatically assign reviewers based on CODEOWNERS"
        },
        "request_review_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub usernames to request review from"
        }
      }
    },
    "pr_description_template": {
      "type": "string",
      "default": "## Summary\nQuick documentation update requested via Documentation Update Tool.\n\n## Original Request\n**URL:** {url}\n**Change:** {edit_prompt}\n\n## Files Changed\n{files_changed}\n\n## Changes Made\n{changes_list}\n\n## Review Notes\n- Minimal, surgical edit preserving existing content\n- Markdown syntax validated\n- No metadata changes (unless requested)\n- No broken links introduced\n\n## Requester Information\n{requester_info}\n\n---\n*Generated by Windows Documentation Update Tool*"
    },
    "repository_mapping": {
      "type": "object",
      "description": "URL pattern to repository mappings",
      "properties": {
        "mapping_guide_url": {
          "type": "string",
          "format": "uri",
          "default": "https://review.learn.microsoft.com/en-us/windows-authoring-guide/writing-guidance/repo-locations?branch=main",
          "description": "URL to the official repository mapping guide"
        },
        "common_mappings": {
          "type": "object",
          "description": "Common URL path prefixes to repository mappings",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "description": "Repository name (e.g., 'MicrosoftDocs/windows-dev-docs-pr')"
              },
              "private_repo": {
                "type": "string",
                "description": "Private version of repo (with -pr suffix)"
              },
              "public_repo": {
                "type": "string",
                "description": "Public version of repo"
              }
            }
          },
          "default": {
            "/windows/apps": {
              "private_repo": "MicrosoftDocs/windows-dev-docs-pr",
              "public_repo": "MicrosoftDocs/windows-dev-docs"
            },
            "/windows-hardware": {
              "private_repo": "MicrosoftDocs/windows-driver-docs-pr",
              "public_repo": "MicrosoftDocs/windows-driver-docs"
            },
            "/windows/uwp": {
              "private_repo": "MicrosoftDocs/windows-dev-docs-pr",
              "public_repo": "MicrosoftDocs/windows-dev-docs"
            },
            "/windows/win32": {
              "private_repo": "MicrosoftDocs/win32-pr",
              "public_repo": "MicrosoftDocs/win32"
            }
          }
        },
        "fallback_search": {
          "type": "boolean",
          "default": true,
          "description": "Search page HTML for repo references if mapping not found"
        }
      }
    },
    "file_mapping": {
      "type": "object",
      "description": "URL to file path mapping rules",
      "properties": {
        "strip_language_codes": {
          "type": "boolean",
          "default": true,
          "description": "Remove language codes like /en-us/ from paths"
        },
        "try_index_fallback": {
          "type": "boolean",
          "default": true,
          "description": "If path.md not found, try path/index.md"
        },
        "file_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [".md", ".yml"],
          "description": "File extensions to try in order"
        }
      }
    },
    "validation": {
      "type": "object",
      "description": "Validation settings for edits",
      "properties": {
        "check_markdown_syntax": {
          "type": "boolean",
          "default": true,
          "description": "Validate markdown syntax after edit"
        },
        "preserve_metadata": {
          "type": "boolean",
          "default": true,
          "description": "Ensure YAML frontmatter is not accidentally changed"
        },
        "check_links": {
          "type": "boolean",
          "default": true,
          "description": "Check that no links were broken"
        },
        "require_user_approval": {
          "type": "boolean",
          "default": true,
          "description": "Show diff and require user approval before committing"
        },
        "max_changes": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of lines changed (safety check)"
        },
        "exclude_reference_content": {
          "type": "boolean",
          "default": true,
          "description": "Block edits to API reference documentation (different publishing pipeline)"
        },
        "reference_content_indicators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ms.topic: reference",
            "ms.topic: api",
            "api_name:",
            "api_type:",
            "uid:",
            "/api/",
            "namespace:",
            "assembly:"
          ],
          "description": "Metadata fields or path patterns that indicate API reference content"
        }
      }
    },
    "ai_editing": {
      "type": "object",
      "description": "AI-powered editing settings",
      "properties": {
        "model": {
          "type": "string",
          "default": "claude-sonnet-4.5",
          "description": "LLM model to use for understanding and making edits"
        },
        "temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "description": "Lower temperature for more precise, deterministic edits"
        },
        "max_tokens": {
          "type": "integer",
          "default": 4096,
          "description": "Maximum tokens for AI response"
        },
        "preserve_style": {
          "type": "boolean",
          "default": true,
          "description": "Attempt to match existing writing style"
        },
        "follow_style_guide": {
          "type": "string",
          "default": "microsoft",
          "enum": ["microsoft", "google", "ap", "none"],
          "description": "Writing style guide to follow"
        }
      }
    },
    "user_preferences": {
      "type": "object",
      "description": "User-specific preferences",
      "properties": {
        "auto_push": {
          "type": "boolean",
          "default": true,
          "description": "Automatically push branch to remote"
        },
        "auto_create_pr": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create PR after push"
        },
        "verbose_output": {
          "type": "boolean",
          "default": false,
          "description": "Show detailed progress information"
        },
        "confirm_each_step": {
          "type": "boolean",
          "default": false,
          "description": "Ask for confirmation at each major step"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata for tracking tool usage",
      "properties": {
        "version": {
          "type": "string",
          "default": "1.0.0"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "usage_stats": {
          "type": "object",
          "properties": {
            "total_updates": {
              "type": "integer",
              "default": 0
            },
            "successful_updates": {
              "type": "integer",
              "default": 0
            },
            "failed_updates": {
              "type": "integer",
              "default": 0
            }
          }
        }
      }
    }
  }
}
